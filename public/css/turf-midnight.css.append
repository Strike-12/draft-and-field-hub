
/* ===== Phase 6: Build My Team ===== */
.hero-card { text-align: center; padding: 36px 20px; }
.hero-title { font-size: 2rem; margin-bottom: 8px; color: var(--turf); }
.hero-btn { max-width: 280px; margin: 16px auto 0; display: block; }
.connect-card {
  margin-top: 18px; padding: 16px;
  border: 1px dashed rgba(6,214,160,0.5); border-radius: 10px;
}
.connect-card h3 { color: var(--turf); margin-bottom: 6px; font-size: 1rem; }
